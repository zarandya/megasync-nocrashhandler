From: Almos Zarandy <git@almoszarandy.me>
Date: Tue, 7 Apr 2026 10:56:20 +0100
Subject: [PATCH] rename tray icons to work in flatpak container

---
 src/MEGASync/gui/TrayIconManager.cpp |   4 +-
 src/MEGASync/gui/gui.cmake           | 110 ++++++++++++++++++++++++---
 2 files changed, 100 insertions(+), 14 deletions(-)

diff --git a/src/MEGASync/gui/TrayIconManager.cpp b/src/MEGASync/gui/TrayIconManager.cpp
index 79f1914..bd4cea7 100644
--- a/src/MEGASync/gui/TrayIconManager.cpp
+++ b/src/MEGASync/gui/TrayIconManager.cpp
@@ -70,16 +70,12 @@ void TrayIconManager::initTrayIcon()
 
 QString TrayIconManager::themePrefix() const
 {
-#ifdef Q_OS_LINUX
-    return QStringLiteral(":/reddish/");
-#else
-    return (mTheme == Theme::Dark) ? QStringLiteral(":/dark/") : QStringLiteral(":/light/");
-#endif
+    return (mTheme == Theme::Dark) ? QStringLiteral("nz.mega.MEGAsync.dark_") : QStringLiteral("nz.mega.MEGAsync.light_");
 }
 
 QIcon TrayIconManager::loadIcon(const QString& filename) const
 {
-    QIcon icon(themePrefix() + filename);
+    QIcon icon = QIcon::fromTheme(themePrefix() + filename);
 
 #ifdef __APPLE__
     if (!icon.isNull())
